# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Bundled sidecars (yt-dlp, ffmpeg). Kept out of git because they are large
# (ffmpeg static is ~100MB) and are platform-specific release artifacts, not
# source. See binaries/README.md for how to populate this directory.
/binaries/*
!/binaries/README.md
